MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/dbname?authSource=admin&retryWrites=true&w=majority"
MONGODB_DB=test
PORT=8000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-byte-hex-string
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed origins, e.g. https://admin.vishva-erp.com,http://localhost:8081
# If unset, all origins are allowed (development only — do not leave unset in production).
CORS_ORIGINS=

# Master encryption key for encrypting college Razorpay secrets in MongoDB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-string

# Platform Razorpay account (used ONLY for ERP subscription payments, NOT student fees)
PLATFORM_RAZORPAY_KEY_ID=rzp_test_placeholder
PLATFORM_RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# Legacy Razorpay keys (kept for backward compatibility, prefer college-specific configs)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

LOG_LEVEL=info

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_cloud_secret

# AI/ML Configuration — Provider priority: Ollama > Groq > OpenAI > Mock
# Ollama (free, local — no API key needed, install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60000

# Groq (free tier, fast — get key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini — free tier (get a key: https://aistudio.google.com/apikey).
# Free tier covers the Flash models with generous daily quotas; check exact
# RPM/RPD for your project at https://aistudio.google.com/rate-limit
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Image-question extraction model (defaults to GEMINI_MODEL when unset)
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# ── Google Workspace integration ────────────────────────────────────────────
# 1) Google Sign-In (OAuth 2.0). Create a "Web application" OAuth client at
#    https://console.cloud.google.com/apis/credentials, then add
#    GOOGLE_REDIRECT_URI to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api-host/api/auth/google/callback
# Deep link the backend hands the session back to (registered by the mobile app WebView)
GOOGLE_APP_REDIRECT_URI=vishvaerp://auth

# 2) Google Meet + Sheets (service account). Create one at
#    https://console.cloud.google.com/iam-admin/serviceaccounts and grant it:
#      - "Make changes to events" on GOOGLE_CALENDAR_ID (for Meet links)
#      - Sheets + Drive access (for live data sync)
#    Paste the JSON key's client_email and private_key (keep \n escapes).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=primary

# 3) Real-time Sheets sync flush interval (ms)
GOOGLE_SHEET_SYNC_INTERVAL_MS=10000

# OpenAI (paid — get key from https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
